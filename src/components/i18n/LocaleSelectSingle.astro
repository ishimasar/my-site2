---
// Select UI to switch between locales.

import { getLocalePaths, LOCALES } from "../../i18n";
---

<label>
  <select data-languageSelect title="表示言語を選ぶ">
    {
      getLocalePaths(Astro.url).map(({ path, lang }) => (
        <option
          label={LOCALES[lang].label}
          value={path}
          data-lang={lang}
          selected={lang === Astro.currentLocale}
          dir={LOCALES[lang].dir || null}
        />
      ))
    }
  </select>
</label>

<script is:inline>
  const selects = document.querySelectorAll("[data-languageSelect]");

  selects.forEach((select) => {
    select.addEventListener("change", (event) => {
      // used for 404 page
      localStorage.selectedLang = event.target?.selectedOptions[0].dataset.lang;
      location.href = event.target?.value;
    });
  });
</script>

<style lang="scss">
  @use "../../assets/scss/base/setting" as s;

  label {
    display: inline-block;
    position: relative;
    width: 10rem;
    margin-block-end: 1.5rem;
    margin-inline-end: 5%;
    text-align-last: left;
    font-family: "Material Icons Sharp";
    .material-icons-sharp {
      position: absolute;
      color: var(--text-normal-color);
      pointer-events: none;
      &:first-child {
        font-size: var(--font-size-d);
        inset: 8px auto 8px 8px;
        opacity: 0.4;
      }
      &:last-child {
        font-size: var(--font-size-d);
        inset: 6px 6px 6px auto;
      }
    }
    &::before {
      content: "";
      display: block;
      position: absolute;
      inset: 12% .4rem;
      width: 2.25rem;
      height: 100%;
      background: no-repeat url('data:image/svg+xml;base64,');
      pointer-events: none;
    }
    &::after {
      @include s.arrowHead(10, 3, bottom, var(--text-normal-color));
      inset-block: 1rem;
      inset-inline-end: 1rem;
      pointer-events: none;
    }
  }
  select {
    width: 100%;
    height: 2.5rem;
    padding-inline: 3rem;
    border: 1px solid var(--frame-color);
    background-color: #faf9f6;
    font-family: "Noto Sans";
    font-size: var(--font-size-c);
    color: var(--text-normal-color);
    border-radius: .25rem;
    box-shadow: 2px 2px 2px 1px hsl(0 0% 0% / .15);
    cursor: pointer;
    appearance: none;
  }
</style>
