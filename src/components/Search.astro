---
import "@pagefind/default-ui/css/ui.css";
---

<div class="searchContainer mt48">
  <search id="search"></search>
</div>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  new PagefindUI({
    element        : '#search',
    baseUrl        : '',
    pageSize       : 5,
    excerptLength  : 38,
    showSubResults : false,
    showImages     : true,
    translations   : {
      placeholder  : '記事を検索する',
      clear_search : 'Clear',
      load_more    : 'Show more',
      search_label : '',
      zero_results : '「[SEARCH_TERM]」に一致する記事は見つかりませんでした',
      many_results : '「[SEARCH_TERM]」の検索結果（[COUNT] 件）',
      one_result   : '「[SEARCH_TERM]」の検索結果（[COUNT] 件）',
      searching    : '「[SEARCH_TERM]」を検索しています...',
    },
    debounceTimeoutMs: 500,
  });
</script>

<style lang="scss" is:global>
  @use "../assets/scss/base/setting" as s;

  :root {
    --pagefind-ui-scale: .9;
    --pagefind-ui-border-width: 1.5px;
    --pagefind-ui-border: #503626;
    --pagefind-ui-border-radius: 5px;
    --pagefind-ui-image-border-radius: 5px;
  }
  .searchContainer {
    display: flex;
    justify-content: center;
    margin-inline: auto;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      width: 36rem;
    }
    @include s.mq(sp-tb) {
      width: 90vw;
    }
  }
  #search {
    & .pagefind-ui__search-input {
      height: calc(64px * var(--pagefind-ui-scale));
      padding: 0 calc(70px * var(--pagefind-ui-scale)) 0 calc(54px * var(--pagefind-ui-scale));
      border: var(--pagefind-ui-border-width) solid var(--pagefind-ui-border);
      background-color: var(--pagefind-ui-background);
      font-size: calc(21px * var(--pagefind-ui-scale));
      border-radius: var(--pagefind-ui-border-radius);
      box-shadow: inset 2px 2px 3px 1px hsl(0 0% 0% / .2);
      @include s.mq(dt) {
        width: 36rem;
      }
      @include s.mq(sp-tb) {
        width: 90vw;
      }
    }
    & .pagefind-ui__drawer {
      width: 100%;
      @include s.mq(sp-tb) {
        width: 100%;
        max-width: 96vw;
      }
    }
    & .pagefind-ui__results-area {
      margin-block-start: 0;
    }
    & .pagefind-ui__result {
      display: flex;
      align-items: flex-start;
      gap: min(calc(30px * var(--pagefind-ui-scale)), 3%);
      list-style-type: none;
      padding: calc(10px * var(--pagefind-ui-scale)) 1rem calc(30px * var(--pagefind-ui-scale));
      border-top: solid var(--pagefind-ui-border-width) var(--pagefind-ui-border);
      background-color: var(--white);
    }
    & .pagefind-ui__result-title {
      font-size: var(--font-size-d);
    }
    & .pagefind-ui__button {
      margin-block-start: 1.5rem;
    }
  }
</style>
