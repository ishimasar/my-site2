---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Head from '../../../components/Head.astro';
import '../../../assets/scss/global.scss'

const allPosts = await Astro.glob("../../../content/blog/*.{md,mdx}");
const tags = [...new Set(allPosts.map((post) => post.frontmatter.tags).flat().sort((a, b) => a.localeCompare(b)))];
const pageTitle = "category Index";
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <Head />
  </head>
  <body>
    <BaseLayout pageTitle={pageTitle}>
      <div class="bloglistWrap">
        <h1 class="geHeading1Subpage">
          <span class="ja">すべてのタグ</span>
        </h1>
        <div class="tags">
          {tags.map((tag) => (
            <a class="tag" href={`/blog/tags/${tag}`}><svg class="icon-tag" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="tag" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-inline--fa fa-tag fa-w-16"><path class="icon-tag" fill="currentColor" d="M0 252.118V48C0 21.49 21.49 0 48 0h204.118a48 48 0 0 1 33.941 14.059l211.882 211.882c18.745 18.745 18.745 49.137 0 67.882L293.823 497.941c-18.745 18.745-49.137 18.745-67.882 0L14.059 286.059A48 48 0 0 1 0 252.118zM112 64c-26.51 0-48 21.49-48 48s21.49 48 48 48 48-21.49 48-48-21.49-48-48-48z" class=""></path></svg>{tag}</a>
          ))}
        </div>
        <a href="/blog/" class="geLinkButton mt48">« ブログ記事一覧へ</a>
      </div>
    </BaseLayout>
  </body>
</html>

<style lang="scss">
  @use "../../../assets/scss/base/setting" as s;

  .bloglistWrap {
    height: 100vh;
    padding: {
      top: 2rem;
      bottom: 4rem;
    };
    background-color: #fbf5ee;
  }
  .icon-tag {
    width: 2rem;
    height: auto;
    margin-right: 0.3rem;
  }
  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 3rem;
    width: 90%;
    margin: auto;
  }
  .tag {
    display: inline-block;
    width: max-content;
    text-decoration: underline;
    font-size: var(--font-size-e);
    &:hover,
    &:focus {
      text-decoration: none;
    }
  }
</style>