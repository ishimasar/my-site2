---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Head from '../../../components/Head.astro';
import '../../../assets/scss/global.scss'

const allPosts = await Astro.glob("../../../content/blog/*.{md,mdx}");
const cate = [...new Set(allPosts.map((post) => post.frontmatter.category).flat())];
const pageTitle = "category Index";
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <Head />
  </head>
  <body>
    <BaseLayout pageTitle={pageTitle}>
      <div class="bloglistWrap">
        <h1 class="geHeading1Subpage">
          <span class="ja">カテゴリー一覧</span>
        </h1>
        <div class="categories">
          {cate.map((category) => (
            <a class="category" href={`/blog/category/${category}`}><svg class="icon-category" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="folder-open" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" class="svg-inline--fa fa-folder-open fa-w-18"><path fill="currentColor" d="M572.694 292.093L500.27 416.248A63.997 63.997 0 0 1 444.989 448H45.025c-18.523 0-30.064-20.093-20.731-36.093l72.424-124.155A64 64 0 0 1 152 256h399.964c18.523 0 30.064 20.093 20.73 36.093zM152 224h328v-48c0-26.51-21.49-48-48-48H272l-64-64H48C21.49 64 0 85.49 0 112v278.046l69.077-118.418C86.214 242.25 117.989 224 152 224z"></path></svg>{category}</a>
          ))}
        </div>
        <a href="/blog/" class="geLinkButton">⬅ ブログ記事一覧へ</a>
      </div>
    </BaseLayout>
  </body>
</html>

<style lang="scss">
  @use "../../../assets/scss/base/setting" as s;

  .bloglistWrap {
    height: 100vh;
    padding: {
      top: 2rem;
      bottom: 4rem;
    };
    background-color: #fbf5ee;
  }
  .icon-category {
    width: 2rem;
    height: auto;
    margin-right: 1rem;
  }
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 3.5rem;
    width: 60%;
    margin: auto;
  }
  .category {
    display: inline-block;
    width: max-content;
    // text-decoration: underline;
    font-size: var(--font-size-f);
    // &:hover,
    // &:focus {
    //   text-decoration: none;
    // }
  }
</style>