---
import { getEntryBySlug, CollectionEntry, getCollection } from 'astro:content';

import Layout from '../../layouts/Layout.astro';
import Head from '../../components/Head.astro';
import '../../assets/scss/global.scss'

type Props = {
    page: Page<CollectionEntry<'blog'>>;
};

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const numberOfPosts = blogEntries.length;
  const nonDraftPosts = blogEntries.filter((blog) => !blog.draft);

  return nonDraftPosts.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prevPost:
        i + 1 === numberOfPosts
          ? ''
          : nonDraftPosts[i + 1],
      nextPost:
        i === 0
          ? ''
          : nonDraftPosts[i - 1]
    },
  }));
}

const { prevPost, nextPost } = Astro.props;

const { slug } = Astro.params as { slug: string };
const entry = (await getEntryBySlug('blog', slug)) as CollectionEntry<'blog'>;
const { Content, remarkPluginFrontmatter } = await entry.render();

const title = remarkPluginFrontmatter.title + ' | UKIGUMO CAFE - ブログ・ポートフォリオサイト';
const description = remarkPluginFrontmatter.description;
const permalink = 'https://nova.drifting-clouds.com/blog/' + remarkPluginFrontmatter.slug;
const ogtype = 'article';
const ogimage = 'https://nova.drifting-clouds.com' + remarkPluginFrontmatter.thumb;
---
<!DOCTYPE html>
<html lang="ja">
  <head prefix="og:http://ogp.me/ns# fb:http://ogp.me/ns/fb# article:http://ogp.me/ns/article#">
    <Head {title} {description} {permalink} {ogtype} {ogimage} />
  </head>
  <body>
    <Layout minutesRead={remarkPluginFrontmatter["minutesRead"]}>
      <main class="artWrapper">
        <article class="artArticle">
          <div class="geFlexbox mb20">
            <div class="artBacklinkWrap"><a class="link" href="../blog/" title="return link">　↼　</a></div>
            <p class="artMinRead">Read in about {remarkPluginFrontmatter.minutesRead} minutes</p>
          </div>
          <h1>{remarkPluginFrontmatter.title}</h1>
          <img src={remarkPluginFrontmatter.thumb} alt="アイキャッチ" width="339" height="191" decoding="async">
          <div class="artTimeContainer">
            <span class="artTime">
              <svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="history" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-inline--fa fa-history fa-w-16"><path fill="currentColor" d="M504 255.531c.253 136.64-111.18 248.372-247.82 248.468-59.015.042-113.223-20.53-155.822-54.911-11.077-8.94-11.905-25.541-1.839-35.607l11.267-11.267c8.609-8.609 22.353-9.551 31.891-1.984C173.062 425.135 212.781 440 256 440c101.705 0 184-82.311 184-184 0-101.705-82.311-184-184-184-48.814 0-93.149 18.969-126.068 49.932l50.754 50.754c10.08 10.08 2.941 27.314-11.313 27.314H24c-8.837 0-16-7.163-16-16V38.627c0-14.254 17.234-21.393 27.314-11.314l49.372 49.372C129.209 34.136 189.552 8 256 8c136.81 0 247.747 110.78 248 247.531zm-180.912 78.784l9.823-12.63c8.138-10.463 6.253-25.542-4.21-33.679L288 256.349V152c0-13.255-10.745-24-24-24h-16c-13.255 0-24 10.745-24 24v135.651l65.409 50.874c10.463 8.137 25.541 6.253 33.679-4.21z" class=""></path></svg>公開日: <time datetime={`${remarkPluginFrontmatter.publishDate}`}></time>{remarkPluginFrontmatter.publishDate}</span>
            <span class="artTime">
              <svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="sync" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-inline--fa fa-sync fa-w-16"><path fill="currentColor" d="M440.65 12.57l4 82.77A247.16 247.16 0 0 0 255.83 8C134.73 8 33.91 94.92 12.29 209.82A12 12 0 0 0 24.09 224h49.05a12 12 0 0 0 11.67-9.26 175.91 175.91 0 0 1 317-56.94l-101.46-4.86a12 12 0 0 0-12.57 12v47.41a12 12 0 0 0 12 12H500a12 12 0 0 0 12-12V12a12 12 0 0 0-12-12h-47.37a12 12 0 0 0-11.98 12.57zM255.83 432a175.61 175.61 0 0 1-146-77.8l101.8 4.87a12 12 0 0 0 12.57-12v-47.4a12 12 0 0 0-12-12H12a12 12 0 0 0-12 12V500a12 12 0 0 0 12 12h47.35a12 12 0 0 0 12-12.6l-4.15-82.57A247.17 247.17 0 0 0 255.83 504c121.11 0 221.93-86.92 243.55-201.82a12 12 0 0 0-11.8-14.18h-49.05a12 12 0 0 0-11.67 9.26A175.86 175.86 0 0 1 255.83 432z" class=""></path></svg>更新日: <time datetime={`${remarkPluginFrontmatter.updateDate}`}></time>{remarkPluginFrontmatter.updateDate}</span>
          </div>
          <Content />
          <hr>
          <div class="ta-r">
            <div class="artCateWrap">Category: {remarkPluginFrontmatter.category}</div>
            <div class="artTagWrap">
              <div>Tag:</div>
              {remarkPluginFrontmatter.tags.map((tag: any) => (
                <div class="pl8">#{tag}</div>
              ))}
            </div>
            <div class="artAuthor">Author:
              <a class="link" href="https://www.drifting-clouds.com/about">{remarkPluginFrontmatter.author}</a>
            </div>
          </div>
        </article>
        <div class="nearContContainer">
          {nextPost && <a class="link -prev" href={`/blog/${nextPost.slug}`}>&lt; 前の記事<br>{nextPost.data.title}</a>}
          {prevPost && <a class="link -next" href={`/blog/${prevPost.slug}`}>次の記事 &gt;<br>{prevPost.data.title}</a>}
        </div>
        <div class="filterContainer">
          <a class="category" href="/blog/category/">すべてのカテゴリー</a>
          <a class="tag" href="/blog/tags/">すべてのタグ</a>
        </div>
        <a href="/blog/" class="geLinkButton">« ブログ記事一覧へ</a>
      </main>
    </Layout>
  </body>
</html>

<style is:global lang="scss">
  @use "../../assets/scss/base/setting" as s;
  @use "../../assets/scss/general/7-typography/heading" as heading;
  @use "../../assets/scss/general/7-typography/bodytext" as body;

  .math.math-display {
    margin: 1rem auto auto;
  }
  a .math.math-inline .katex *,
  a[href*=katex] {
    text-decoration: none !important;
  }
  .svg-inline--fa.fa-w-16 {
    &.fa-history,
    &.fa-sync {
      width: 1.2em;
      padding-right: .3rem;
    }
  }
  h2[id=contents] {
    width: fit-content;
    margin: 1.5rem auto 0;
    padding: .25rem .5rem;
    border-bottom: 1px solid var(--line-color);
    text-align: center;
    line-height: 1;
    font-weight: 600;
    font-size: var(--font-size-d);
  }
  h2[id=contents] + ul {
    margin: .5rem auto;
    list-style-type: decimal;
    border: 1px dotted var(--line-color);
    @include s.mq(dt) {
      width: 42rem;
      padding: .75rem 4rem;
    }
    @include s.mq(sp-tb) {
      width: 90%;
      padding: .5rem 1.5rem .75rem 2.5rem;
    }
    > li, * {
      > a {
        display: block;
        margin: {
        top: .25rem;
        bottom: .25rem;
      };
        padding: {
          top: .5rem;
          bottom: .5rem;
        };
        @include s.mq(dt) {
          line-height: 1.5;
          font-size: var(--font-size-d);
        }
        @include s.mq(sp-tb) {
          line-height: 1.5;
          font-size: var(--font-size-c);
        }
      }
    }
  }
  .artBacklinkWrap {
    width: 45%;
    margin-right: auto;
    > .link {
      padding: {
        top: .5rem;
        bottom: .5rem;
      }
      font-size: var(--font-size-f);
    }
  }
  .artMinRead {
    width: 55%;
    margin-left: auto;
    padding-top: 0 !important;
    text-align: right;
    @include s.mq(dt) {
      font-size: var(--font-size-c);
    }
    @include s.mq(sp-tb) {
      font-size: var(--font-size-b);
    }
  }
  .artWrapper {
    position: relative;
    width: 100%;
    min-height: 40.3vh;
    margin: auto;
    background-color: var(--bg-pale-color);
    @include s.mq(dt) {
      padding: {
        top: 3rem;
        bottom: 6rem;
      }
    }
    @include s.mq(sp-tb) {
      padding: {
        top: 2rem;
        bottom: 4rem;
      }
    }
  }
  .artArticle {
    max-width: 60rem;
    margin: auto;
    border: 1.5px solid var(--line-color);
    background-color: var(--white);
    border-radius: 0.25rem;
    box-shadow: 0 10px 15px 3px hsla(0, 0%, 0%, 0.1),
      0 4px 6px -1px rgba(0, 0, 0, 0.05);
    @include s.mq(tb-dth) {
      padding: 3rem 5rem 4rem;
    }
    @include s.mq(sp-tb) {
      width: 96vw;
      max-width: 52rem;
      padding: 2rem 1rem;
    }
    @include s.mq(tb-dth) {
      margin-bottom: 2rem;
    }
    @include s.mq(sp) {
      max-width: 96vw;
      margin-bottom: 1.5rem;
    }
    &:not(:first-of-type) {
      padding-top: 2rem;
    }
    h1 {
      text-align: center;
      font-family: var(--sentence-font);
      font-weight: bold;
      letter-spacing: 0.08rem;
      @include s.mq(dt) {
        margin-bottom: 1.5rem;
        font-size: var(--font-size-g);
      }
      @include s.mq(sp-tb) {
        margin-bottom: 2rem;
        font-size: calc(var(--font-size-e) + 0.15rem);
      }
      > .en {
        display: block;
        margin: 0.8rem auto;
        @include s.engFont;
        font-weight: bold;
        text-transform: uppercase;
        @include s.mq(dt) {
          font-size: var(--font-size-d);
        }
      }
      &::after {
        content: '';
        display: block;
        width: 100px;
        margin: auto;
        padding-top: 1rem;
        border-bottom: 1px solid var(--frame-color);
      }
    }
    & h2:not([id=contents]) {
      @include s.mq(dt) {
        margin-top: 2.5rem;
      }
      @include s.mq(sp-tb) {
        margin-top: 2rem;
      }
    }
    > h2:not([id=contents]) {
      @extend %geHeading2Article;
    }
    & h3 {
      display: table;
      position: relative;
      background: linear-gradient(transparent 89%, var(--text-highlight-color) 87%);
      @include s.hrMarginTop(2rem);
      font-style: normal;
      font-weight: bold;
      @include s.mq(dt) {
        font-size: var(--font-size-d);
      }
      @include s.mq(sp-tb) {
        font-size: var(--font-size-c);
      }
    }
    > p {
      margin-top: 1.5rem;
      font-family: var(--sentence-font);
      @include s.mq(dt) {
        font-size: var(--font-size-d);
      }
      > a {
        text-decoration: underline;
        color: var(--accent-color);
        @include s.mq(dt) {
          &:hover {
            text-decoration: none;
          }
        }
        & * {
          text-decoration: underline;
        }
      }
    }
    & p span,
    &  time {
      font-family: var(--sentence-font);
    }
    h1 + img {
      display: block;
      margin: auto;
      aspect-ratio: 16 / 9;
      @include s.mq(dt) {
        width: 42rem;
      }
      @include s.mq(sp-tb) {
        width: 100%;
      }
    }
    & img:not(h1 + img) {
      @include s.mq(dt) {
        width: 80%;
        margin: 1rem auto;
      }
      @include s.mq(sp-tb) {
        width: 100%;
        margin: .5rem 0;
      }
    }
    & strong {
      position: relative;
      background: linear-gradient(
        transparent 89%,
        var(--text-highlight-color) 87%
      );
      color: var(--text-dark-color);
    }
    & em {
      font-style: normal;
      font-weight: bold;
    }
    > figure {
      width: auto;
      max-width: 37.5rem;
      margin: 2rem auto;
      text-align: center;
    }
    & figcaption {
      margin-top: 1.5rem;
    }
    > span:not([class*='token']):not([class='line-numbers-rows']) {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.2rem 0.8rem;
      border: 1px solid var(--text-dark-color);
      background-color: var(--white);
      font-weight: normal;
      font-size: calc(var(--font-size-c) - 0.02rem);
      color: var(--text-dark-color);
      border-radius: 0.3rem 0.3rem 0 0;
      &:first-of-type {
        margin-top: 1.8rem;
      }
    }
    & pre {
      margin-top: 0;
      padding: 1rem .5rem;
      border-radius: 0.3rem;
    }
    & code {
      font-size: calc(var(--font-size-c) - 0.01rem);
      @include s.mq(tb-dth) {
        line-height: 1.6;
      }
      @include s.mq(sp) {
        line-height: 1.4;
        font-size: var(--font-size-b);
      }
    }
    & p > code {
      margin: -.2em .3em 0;
      padding: .1em .4em .15em;
      background-color: #efefef;
      border-radius: 3px;
    }
    > ul:not([id=contents] + ul),
    > ol {
      padding: {
        top: 1rem;
        left: 1.5em;
      }
      line-height: 1.7;
      font-family: var(--sentence-font);
      @include s.mq(tb-dth) {
        font-size: var(--font-size-d);
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
      & li {
        padding: .5rem 0;
      }
    }
    > ul {
      list-style: disc;
      & ul {
        padding-left: 1em;
        list-style-type: circle;
      }
    }
    > ol {
      list-style: decimal;
    }
    & blockquote {
      position: relative;
      margin: 1.5rem 0 auto;
      padding-left: 1.25rem;
      > p {
        color: hsla(0, 0%, 45%, 1);
        @include s.mq(tb-dth) {
          font-size: var(--font-size-d);
        }
        @include s.mq(sp) {
          font-size: var(--font-size-c);
        }
      }
      & a {
        color: var(--accent-color);
        text-decoration: underline;
        &:hover,
        &:focus {
          text-decoration: none;
        }
      }
      &::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: auto;
        height: 100%;
        border-left: 4px solid hsla(0, 0%, 45%, 1);
      }
    }
    & small {
      display: block;
      margin-top: 0.25rem;
    }
    & hr {
      width: 100%;
      height: 1px;
      margin-top: 1rem;
      border: none;
      background-color: hsla(23, 36%, 23%, .8);
    }
    & iframe {
      display: block;
      width: 60vw;
      min-width: 300px;
      max-width: 560px;
      margin: 1.5rem auto auto;
      aspect-ratio: 16 / 9;
    }
    [style*="545454"] {
      color: #b5b5b5 !important;
    }
    & ruby > rt {
      font-size: 65%;
    }
    .recharts-wrapper {
      margin: 2rem auto auto;
    }
  }
  .artTimeContainer {
    display: flex;
    justify-content: space-evenly;
    width: auto;
    height: 100%;
    margin: .5rem auto 0;
    @include s.mq(tb-dth) {
      max-width: 30rem;
    }
    @include s.mq(sp) {
      width: 95%;
    }
  }
  .artTime {
    display: block;
    text-align: center;
    font-family: var(--sentence-font);
    @include s.mq(tb-dth) {
      font-size: var(--font-size-d);
    }
    @include s.mq(sp) {
      font-size: calc(var(--font-size-b) + 0.03rem);
    }
    &:not(:first-of-type) {
      padding-left: 0.4rem;
    }
  }
  .artTagWrap {
    display: flex;
    justify-content: flex-end;
  }
  .artCateWrap,
  .artTagWrap div {
    @include s.mq(tb-dth) {
      font-size: var(--font-size-d);
    }
    @include s.mq(sp) {
      font-size: var(--font-size-c);
    }
  }
  div.artAuthor {
    margin-top: .5rem;
    padding-top: 0;
    > .link {
      text-decoration: underline;
      color: var(--accent-color);
      @include s.mq(tb-dth) {
        font-size: var(--font-size-d);
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
      &:hover,
      &:focus {
        text-decoration: none;
      }
    }
  }
  .nearContContainer {
    width: 80vw;
    max-width: 60rem;
    display: flex;
    margin: auto;
    & .link {
      width: 45%;
      height: 3.2rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-decoration: underline;
      &.-prev {
        margin-right: auto;
      }
      &.-next {
        margin-left: auto;
        text-align: right;
      }
      @include s.mq(tb-dth) {
        font-size: var(--font-size-d);
        &:hover,
        &:focus {
          text-decoration: none;
        }
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
    }
    @include s.mq(tb-dth) {
      justify-content: space-around;
    }
    @include s.mq(sp) {
      justify-content: space-between;
    }
  }
  .filterContainer {
    display: flex;
    justify-content: center;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      gap: 5rem;
      @include s.hrMarginTop(3rem);
    }
    @include s.mq(sp-tb) {
      gap: 2rem;
      @include s.hrMarginTop(1.5rem);
    }
    & .category {
      padding: .75rem;
      border: 1px solid var(--accent-color);
      color: var(--accent-color);
      @include s.mq(dt) {
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
    }
    & .tag {
      padding: .75rem;
      border: 1px solid hsla(136, 78%, 22%, 1);
      color: hsla(136, 78%, 22%, 1);
      @include s.mq(dt) {
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
    }
  }
</style>