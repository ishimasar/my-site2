---
import Layout from '../../../../layouts/Layout.astro';
import Head from '../../../../components/Head.astro';
import Search from '../../../components/Search.astro'
import '../../../../assets/scss/global.scss'

import LocaleSelectSingle from "../../../components/i18n/LocaleSelectSingle.astro";
import { useTranslations, type Lang } from "../../../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
const t = useTranslations(Astro.currentLocale as Lang);

const allPosts = await Astro.glob("../../../../content/blog/ja/*.{md,mdx}");
const nonDraftPosts = allPosts.filter((blog) => !blog.frontmatter.draft);
const cate = [...new Set(nonDraftPosts.map((post) => post.frontmatter.category).flat().sort((a, b) => a.localeCompare(b)))];

const title = 'すべてのカテゴリー | UKIGUMO CAFE - ブログ・ポートフォリオサイト';
const description = 'UKIGUMO CAFE(浮雲カフェ)という架空のカフェサイトのすべてのカテゴリーページです。本当はWeb/IT制作系の情報発信などを中心とした石井将直(屋号:Cloudy Knot)によるポートフォリオサイトです。';
const permalink = 'https://nova.drifting-clouds.com/ja/blog/category/';
const ogtype = 'blog';
const ogimage = 'https://drifting-clouds.com/ogp.png';
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <Head {title} {description} {permalink} {ogtype} {ogimage} />
  </head>
  <body>
    <Layout>
      <div class="bloglistWrap">
        <h1 class="geHeading1Subpage">
          <span class="ja">すべてのカテゴリー</span>
        </h1>
        <div class="categories">
          {cate.map((category) => (
            <a class="category" href={`/ja/blog/category/${category}`}><svg class="icon-category svg-inline--fa fa-folder-open fa-w-18" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="folder-open" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path fill="currentColor" d="M572.694 292.093L500.27 416.248A63.997 63.997 0 0 1 444.989 448H45.025c-18.523 0-30.064-20.093-20.731-36.093l72.424-124.155A64 64 0 0 1 152 256h399.964c18.523 0 30.064 20.093 20.73 36.093zM152 224h328v-48c0-26.51-21.49-48-48-48H272l-64-64H48C21.49 64 0 85.49 0 112v278.046l69.077-118.418C86.214 242.25 117.989 224 152 224z"></path></svg>{category}</a>
          ))}
        </div>
        <Search />
        <a href="/ja/blog/" class="geLinkButton mt48">« ブログ記事一覧へ</a>
      </div>
    </Layout>
  </body>
</html>

<style lang="scss">
  @use "../../../../assets/scss/base/setting" as s;

  .bloglistWrap {
    height: 100%;
    min-height: 100lvh;
    padding-top: 2rem;
    padding-bottom: 4rem;
    background-color: #fbf5ee;
  }
  .icon-category {
    width: 2rem;
    height: auto;
    margin-right: 1rem;
  }
  .categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3.5rem;
    width: 60%;
    margin: auto;
  }
  .category {
    display: inline-block;
    width: max-content;
    font-size: var(--font-size-e);
  }
</style>