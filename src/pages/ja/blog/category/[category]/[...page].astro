---
import Layout from '../../../../../layouts/Layout.astro';
import Head from '../../../../../components/Head.astro';
import Search from '../../../../../components/Search.astro'
import '../../../../../assets/scss/global.scss'

import LocaleSelectSingle from "../../../../../components/i18n/LocaleSelectSingle.astro";
import { useTranslations, type Lang } from "../../../../../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
const t = useTranslations(Astro.currentLocale as Lang);

export async function getStaticPaths({ paginate }) {
  const allPosts = await Astro.glob("../../../../../content/blog/ja/*.{md,mdx}");
  const nonDraftPosts = allPosts.filter((blog) => !blog.frontmatter.draft);
  const uniqueCates = [
    ...new Set(nonDraftPosts.map((post) => post.frontmatter.category).flat().sort((a, b) => a.localeCompare(b))),
  ];
  return uniqueCates.map((category) => {
    const filteredPosts = nonDraftPosts.filter((posts: any) =>
      posts.frontmatter.category.includes(category)
    );
    const sortedPosts = filteredPosts.sort((a, b) => {
      const aDate = new Date(a.frontmatter.publishDate);
      const bDate = new Date(b.frontmatter.publishDate);
      return bDate.getTime() - aDate.getTime();
    });
    return {
      params: { category },
      props: { posts: sortedPosts }
    };
  });
}
const { category } = Astro.params;
const { posts } = Astro.props;

const title = '個別カテゴリーの記事一覧 | UKIGUMO CAFE - ブログ・ポートフォリオサイト';
const description = 'UKIGUMO CAFE(浮雲カフェ)という架空のカフェサイトの個別カテゴリーの記事一覧です。';
const permalink = 'https://nova.drifting-clouds.com/ja/blog/category/' + category;
const ogtype = 'blog';
const ogimage = 'https://drifting-clouds.com/ogp.png';
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <Head {title} {description} {permalink} {ogtype} {ogimage} />
  </head>
  <body>
    <Layout>
      <div class="bloglistWrap">
        <h1 class="geHeading1Subpage">
          <span class="ja">{category}カテゴリーの記事</span>
        </h1>
        <ul class="geFlexbox -card-app">
          {
            posts.map((post: any) => (
              <li class="geCardBlog">
                <div class="frame">
                  <div class="imgContainer">
                    <a href={`/ja/blog/${post.frontmatter.slug}`}>
                      <img src={`${post.frontmatter.thumb}`} alt="ブログ・サムネイル画像" decoding="async" class="thumbnail">
                    </a>
                  </div>
                  <div class="textContainer">
                    <a href={`/ja/blog/${post.frontmatter.slug}`}>
                      <span class="title">{post.frontmatter.title}</span>
                    </a>
                    <div class="excerpt">
                      <p>{post.frontmatter.description}</p>
                    </div>
                    <hr class="rule">
                    <div class="dateContainer">
                      <span class="date">投稿日:
                        <time datetime={`${post.frontmatter.publishDate}`} class="time">{post.frontmatter.publishDate}</time>
                      </span>
                      <span class="date">｜更新日:
                        <time datetime={`${post.frontmatter.updateDate}`} class="time">{post.frontmatter.updateDate}</time>
                      </span>
                    </div>
                    <div class="tagContainer">
                      {post.frontmatter.tags.map((tag: any) => (
                        <div class="tag">#{tag}</div>
                      ))}
                    </div>
                  </div>
                  <div class="categoryLabel">{post.frontmatter.category}</div>
                </div>
              </li>
            ))
          }
        </ul>
        <Search />
        <a href="/ja/blog/category/" class="geLinkButton">« すべてのカテゴリーへ</a>
      </div>
    </Layout>
  </body>
</html>

<style lang="scss">
  @use "../../../../../assets/scss/base/setting" as s;

  .bloglistWrap {
    height: 100%;
    min-height: 100lvh;
    padding-top: 2rem;
    padding-bottom: 4rem;
    background-color: #fbf5ee;
  }
</style>