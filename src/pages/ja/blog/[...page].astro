---
import Layout from '../../../layouts/Layout.astro';
import Head from '../../../components/Head.astro';
import Search from '../../../components/Search.astro'
import '../../../assets/scss/global.scss'

import LocaleSelectSingle from "../../../components/i18n/LocaleSelectSingle.astro";
import { useTranslations, type Lang } from "../../../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
const t = useTranslations(Astro.currentLocale as Lang);

export async function getStaticPaths({ paginate }) {
  const allPosts = await Astro.glob('../../../content/blog/ja/*.{md,mdx}');
  const nonDraftPosts = allPosts.filter((blog) => !blog.frontmatter.draft);

  const sortedPosts = nonDraftPosts.sort((a, b) => {
    const aDate = new Date(a.frontmatter.publishDate);
    const bDate = new Date(b.frontmatter.publishDate);
    return bDate.getTime() - aDate.getTime();
  });
  return paginate(sortedPosts, { pageSize: 6 });
}
const { page } = Astro.props;

const title = 'ブログ記事一覧 | UKIGUMO CAFE - ブログ・ポートフォリオサイト';
const description = 'UKIGUMO CAFE(浮雲カフェ)という架空のカフェサイトのブログ記事一覧ページです。本当はWeb/IT制作系の情報発信などを中心とした石井将直(屋号:Cloudy Knot)によるポートフォリオサイトです。';
const permalink = 'https://nova.drifting-clouds.com/blog/';
const ogtype = 'blog';
const ogimage = 'https://drifting-clouds.com/ogp.png';
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <Head {title} {description} {permalink} {ogtype} {ogimage} />
  </head>
  <body>
    <Layout>
      <div class="bloglistWrap">
        <div class="localeContainer">
          <LocaleSelectSingle />
        </div>
        <h1 class="geHeading1Subpage">
          <span class="ja">ブログ記事一覧</span>
        </h1>
        <p class="geLeadText">
          多岐の物事に興味を持つ雑多人間が、そのときどきで取り留めなく文を綴(つづ)ります。<br>
          ITテクノロジー/Web制作、旅、学問、思考/レビュー、創作、生活/暮らし方などがおもなテーマ。
        </p>
        <ul class="geFlexbox -card-app mt32">
          {
            page.data.map((blog: any) => (
              <li class="geCardBlog">
                <div class="frame">
                  <div class="imgContainer">
                    <a href={`/ja/blog/${blog.frontmatter.slug}`}>
                      <img src={`${blog.frontmatter.thumb}`} alt="ブログ・サムネイル画像" decoding="async" class="thumbnail">
                    </a>
                  </div>
                  <div class="textContainer">
                    <a href={`/ja/blog/${blog.frontmatter.slug}`}>
                      <span class="title">{blog.frontmatter.title}</span>
                    </a>
                    <div class="excerpt">
                      <p>{blog.frontmatter.description}</p>
                    </div>
                    <hr class="rule">
                    <div class="dateContainer">
                      <span class="date">投稿日:
                        <time datetime={`${blog.frontmatter.publishDate}`} class="time">{blog.frontmatter.publishDate}</time>
                      </span>
                      <span class="date">｜更新日:
                        <time datetime={`${blog.frontmatter.updateDate}`} class="time">{blog.frontmatter.updateDate}</time>
                      </span>
                    </div>
                    <div class="tagContainer">
                      {blog.frontmatter.tags.map((tag: any) => (
                        <div class="tag">#{tag}</div>
                      ))}
                    </div>
                  </div>
                  <div class="categoryLabel">{blog.frontmatter.category}</div>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="mt32 ta-c">1ページ最大6件表示</div>
        <div class="gePagination">
          {page.url.prev ? <a class="link" href={page.url.prev}>{page.currentPage - 1}</a> : false}
          <span class="current">{page.currentPage}</span>
          {page.url.next ? <a class="link" href={page.url.next}>{page.currentPage + 1}</a> : false}
        </div>
        {page.currentPage > 2 ? <a class="startLink mt32" href="/ja/blog/">記事一覧1へ</a> : false}
        <div class="filterContainer mt48">
          <a class="category" href="/ja/blog/category/">すべてのカテゴリー</a>
          <a class="tag" href="/ja/blog/tags/">すべてのタグ</a>
        </div>
        <!-- <div class="searchContainer mt48">
          <Search />
        </div> -->
        <a href="https://www.drifting-clouds.com/" class="geLinkButton">« ホームへ</a>
      </div>
    </Layout>
  </body>
</html>

<style lang="scss">
  @use "../../../assets/scss/base/setting" as s;

  .bloglistWrap {
    height: 100%;
    min-height: 100lvh;
    padding-top: 2rem;
    padding-bottom: 4rem;
    background-color: #fbf5ee;
    @include s.mq(sp) {
      height: 100%;
    }
  }
  .filterContainer {
    display: flex;
    justify-content: center;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      gap: 5rem;
    }
    @include s.mq(sp-tb) {
      gap: 2rem;
    }
    & .category {
      padding: .75rem;
      border: 1px solid var(--accent-color);
      color: var(--accent-color);
      @include s.mq(dt) {
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
    }
    & .tag {
      padding: .75rem;
      border: 1px solid hsl(136 78% 22% / 1);
      color: hsl(136 78% 22% / 1);
      @include s.mq(dt) {
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
    }
  }
  .searchContainer {
    display: flex;
    justify-content: center;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      gap: 5rem;
    }
    @include s.mq(sp-tb) {
      gap: 2rem;
    }
  }
  .localeContainer {
    display: flex;
    justify-content: end;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      gap: 5rem;
    }
    @include s.mq(sp-tb) {
      gap: 2rem;
    }
  }
</style>