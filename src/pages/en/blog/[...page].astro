---
import Layout from '../../../layouts/Layout.astro';
import Head from '../../../components/Head.astro';
import Search from '../../../components/Search.astro'
import '../../../assets/scss/global.scss'

import LocaleSelectSingle from "../../../components/i18n/LocaleSelectSingle.astro";
import { useTranslations, type Lang } from "../../../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
const t = useTranslations(Astro.currentLocale as Lang);

export async function getStaticPaths({ paginate }) {
  const allPosts = await Astro.glob('../../../content/blog/ja/*.{md,mdx}');
  const nonDraftPosts = allPosts.filter((blog) => !blog.frontmatter.draft);

  const sortedPosts = nonDraftPosts.sort((a, b) => {
    const aDate = new Date(a.frontmatter.publishDate);
    const bDate = new Date(b.frontmatter.publishDate);
    return bDate.getTime() - aDate.getTime();
  });
  return paginate(sortedPosts, { pageSize: 6 });
}
const { page } = Astro.props;

const title = 'ブログ記事一覧 | UKIGUMO CAFE - ブログ・ポートフォリオサイト';
const description = 'UKIGUMO CAFE(浮雲カフェ)という架空のカフェサイトのブログ記事一覧ページです。本当はWeb/IT制作系の情報発信などを中心とした石井将直(屋号:Cloudy Knot)によるポートフォリオサイトです。';
const permalink = 'https://nova.drifting-clouds.com/blog/';
const ogtype = 'blog';
const ogimage = 'https://drifting-clouds.com/ogp.png';
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <Head {title} {description} {permalink} {ogtype} {ogimage} />
  </head>
  <body>
    <Layout>
      <div class="bloglistWrap">
        <div class="localeContainer">
          <LocaleSelectSingle />
        </div>
        <h1 class="geHeading1Subpage">
          <span class="ja">List of blog articles</span>
        </h1>
        <p class="geLeadText">
          A miscellaneous person with a wide range of interests writes random articles from time to time.<br>
          Main themes include IT technology/web production, travel, academics, thoughts/reviews, creation, and lifestyle/living.
        </p>
        <p class="geLeadText mt32" style="font-size: 2rem;font-weight: 600;">Currently under construction. 👷🚧</p>
        <p class="geLeadText">As of October 2024.</p>
        <a href="https://www.drifting-clouds.com/" class="geLinkButton">« Back to home</a>
      </div>
    </Layout>
  </body>
</html>

<style lang="scss">
  @use "../../../assets/scss/base/setting" as s;

  .bloglistWrap {
    height: 100%;
    min-height: 100lvh;
    padding-top: 2rem;
    padding-bottom: 4rem;
    background-color: #fbf5ee;
    @include s.mq(sp) {
      height: 100%;
    }
  }
  .filterContainer {
    display: flex;
    justify-content: center;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      gap: 5rem;
    }
    @include s.mq(sp-tb) {
      gap: 2rem;
    }
    & .category {
      padding: .75rem;
      border: 1px solid var(--accent-color);
      color: var(--accent-color);
      @include s.mq(dt) {
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
    }
    & .tag {
      padding: .75rem;
      border: 1px solid hsl(136 78% 22% / 1);
      color: hsl(136 78% 22% / 1);
      @include s.mq(dt) {
        &:hover,
        &:focus {
          text-decoration: underline;
        }
      }
      @include s.mq(sp) {
        font-size: var(--font-size-c);
      }
    }
  }
  .searchContainer {
    display: flex;
    justify-content: center;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      gap: 5rem;
    }
    @include s.mq(sp-tb) {
      gap: 2rem;
    }
  }
  .localeContainer {
    display: flex;
    justify-content: end;
    font-size: var(--font-size-d);
    @include s.mq(dt) {
      gap: 5rem;
    }
    @include s.mq(sp-tb) {
      gap: 2rem;
    }
  }
</style>